{
  "name": "typedb-r2-control-plane",
  "private": true,
  "description": "Cloudflare control plane: DatabaseControllerDO / DatabaseContainerDO separation (CF-P1) and real-account probe harness (CF-P0, P-R2-*/P-DO-*)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "probes:platform": "node --experimental-strip-types probes/run-platform-probes.ts",
    "probes:selftest": "bash probes/self-test.sh",
    "probes:preflight": "node --experimental-strip-types probes/preflight.ts",
    "probes:recording-tests": "node --experimental-strip-types --test probes/recording.test.ts",
    "probes:r2": "node --experimental-strip-types probes/run-r2-probes.ts",
    "test": "npm run test:core",
    "test:core": "node --experimental-strip-types --test src/controller/core/*.test.ts src/controller/surface.test.ts",
    "test:controller:mutant": "CONTROLLER_MUTANT=drop-outbox-event node --experimental-strip-types --test src/controller/core/controller-core.test.ts",
    "test:workerd": "vitest run",
    "stack:local": "wrangler dev --local -c wrangler.local-dev.toml --port 8787",
    "stack:e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/local-stack-e2e.mjs",
    "e2e": "node scripts/run-local-e2e.mjs",
    "e2e:managed": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/managed-stack-e2e.mjs",
    "test:quality": "npm run --silent test:core && node --experimental-strip-types --test probes/recording.test.ts",
    "test:capability": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@stryker-mutator/core": "10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "dependency-cruiser": "18.2.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "oxlint": "1.79.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "type": "module"
}
