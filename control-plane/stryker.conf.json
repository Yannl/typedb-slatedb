{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": { "command": "npm run --silent test:quality" },
  "coverageAnalysis": "off",
  "mutate": [
    "src/shared/**/*.ts",
    "src/controller/core/**/*.ts",
    "src/container/**/*.ts",
    "!**/*.test.ts",
    "!**/*.workerd.test.ts",
    "!**/*-test-support.ts"
  ],
  "reporters": ["json", "clear-text", "progress"],
  "jsonReporter": { "fileName": "../artifacts/quality/stryker/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 60000,
  "concurrency": 2,
  "thresholds": { "high": 80, "low": 60, "break": 0 }
}
