+    #[tokio::test]
+    async fn external_epochs_are_exact_beyond_the_double_precision_cliff() {
+        // F7's exactness rule reaches the storage engine: an epoch above
+        // 2^53 must round-trip through issue -> manifest -> read unchanged.
+        let ms = new_memory_manifest_store();
+        let state = ManifestCore::new();
+        StoredManifest::create_new_db(ms.clone(), state.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        let timeout = Duration::from_secs(300);
+        let epoch = (1u64 << 53) + 1;
+        let sm = StoredManifest::load(ms.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        FenceableManifest::init_writer_with_epoch(sm, timeout, Arc::new(DefaultSystemClock::new()), epoch)
+            .await
+            .unwrap();
+        assert_eq!(ms.read_latest_manifest().await.unwrap().manifest.writer_epoch, epoch);
+        // and its immediate predecessor is still refused, i.e. nothing was
+        // rounded to a neighbouring representable value
+        let sm = StoredManifest::load(ms.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        let result =
+            FenceableManifest::init_writer_with_epoch(sm, timeout, Arc::new(DefaultSystemClock::new()), epoch)
+                .await;
+        assert!(matches!(result, Err(error::SlateDBError::Fenced)));
+    }
