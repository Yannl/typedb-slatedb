+    /// of an external epoch a refusal at open instead of a silent fallback
+    /// to internal allocation. Local conformance lanes (single-actor by
+    /// construction) build without it and keep upstream behaviour.
+    pub fn with_external_writer_epoch(mut self, epoch: u64) -> Self {
+        self.external_writer_epoch = Some(epoch);
+        self
