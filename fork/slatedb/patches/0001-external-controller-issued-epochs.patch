+    /// Claim an EXACT, externally issued writer epoch (ADR-0012 / V16
+    /// inv. 78-80).
+    ///
+    /// `init_writer` allocates `stored + 1` internally. That is
+    /// observe-and-bind: the epoch is chosen from what this process happened
+    /// to read, so it cannot compose with a controller that is separately
+    /// fencing the same actor - the two allocators race, and the manifest
+    /// records whichever landed last. Here the controller decides, and the
+    /// store either claims that exact number or refuses.
+    ///
+    /// Fail-closed: `external_epoch <= stored.writer_epoch` returns `Fenced`
+    /// BEFORE any write, so a controller replaying an old epoch is refused
+    /// rather than bumped over. Detection of a later epoch is unchanged: the
+    /// local handle still fences on any manifest with a greater epoch.
+    pub(crate) async fn init_writer_with_epoch(
+        stored_manifest: StoredManifest,
+        manifest_update_timeout: Duration,
+        system_clock: Arc<dyn SystemClock>,
+        external_epoch: u64,
+    ) -> Result<Self, SlateDBError> {
+        let clock = system_clock.clone();
+        let fr = FenceableTransactionalObject::init_with_epoch(
+            stored_manifest.inner,
+            manifest_update_timeout,
+            system_clock,
+            external_epoch,
+            |m: &Manifest| m.writer_epoch,
+            |m: &mut Manifest, e: u64| m.writer_epoch = e,
+        )
+        .await?;
+        Ok(Self { inner: fr, clock })
+    }
+
+    /// The compactor twin of [`Self::init_writer_with_epoch`]. Compactor
+    /// revocation IS issuing a newer compactor epoch to a successor: the old
+    /// job fences out on its next manifest CAS and its already-published
+    /// SSTs stay orphan bytes (inv. 83), never referenced.
+    pub(crate) async fn init_compactor_with_epoch(
+        stored_manifest: StoredManifest,
+        manifest_update_timeout: Duration,
+        system_clock: Arc<dyn SystemClock>,
+        external_epoch: u64,
+    ) -> Result<Self, SlateDBError> {
+        let clock = system_clock.clone();
+        let fr = FenceableTransactionalObject::init_with_epoch(
+            stored_manifest.inner,
+            manifest_update_timeout,
+            system_clock,
+            external_epoch,
+            |m: &Manifest| m.compactor_epoch,
+            |m: &mut Manifest, e: u64| m.compactor_epoch = e,
+        )
+        .await?;
+        Ok(Self { inner: fr, clock })
+    }
