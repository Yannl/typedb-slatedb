+    // ----------------------------------------------------------------
+    // ADR-0012 external (controller-issued) epochs: the qualifying matrix
+    // from docs/design/slatedb-external-epochs.md.
+    // ----------------------------------------------------------------
+
+    #[tokio::test]
+    async fn external_writer_epoch_is_claimed_exactly() {
+        let ms = new_memory_manifest_store();
+        let state = ManifestCore::new();
+        StoredManifest::create_new_db(ms.clone(), state.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        let timeout = Duration::from_secs(300);
+        // The controller issues a number the store did NOT choose: internal
+        // allocation would have produced 1 here.
+        for epoch in [7u64, 9, 10] {
+            let sm = StoredManifest::load(ms.clone(), Arc::new(DefaultSystemClock::new()))
+                .await
+                .unwrap();
+            let fenceable = FenceableManifest::init_writer_with_epoch(
+                sm,
+                timeout,
+                Arc::new(DefaultSystemClock::new()),
+                epoch,
+            )
+            .await
+            .unwrap();
+            assert_eq!(fenceable.local_epoch(), epoch);
+            let manifest = ms.read_latest_manifest().await.unwrap();
+            assert_eq!(manifest.manifest.writer_epoch, epoch, "the exact issued epoch is stored");
+        }
+    }
+
+    #[tokio::test]
+    async fn a_replayed_or_stale_external_epoch_is_refused_before_any_write() {
+        let ms = new_memory_manifest_store();
+        let state = ManifestCore::new();
+        StoredManifest::create_new_db(ms.clone(), state.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        let timeout = Duration::from_secs(300);
+        let sm = StoredManifest::load(ms.clone(), Arc::new(DefaultSystemClock::new()))
+            .await
+            .unwrap();
+        FenceableManifest::init_writer_with_epoch(sm, timeout, Arc::new(DefaultSystemClock::new()), 5)
+            .await
+            .unwrap();
+        let before = ms.read_latest_manifest().await.unwrap();
+
+        for stale in [5u64, 4, 1, 0] {
+            let sm = StoredManifest::load(ms.clone(), Arc::new(DefaultSystemClock::new()))
+                .await
+                .unwrap();
+            let result = FenceableManifest::init_writer_with_epoch(
+                sm,
+                timeout,
+                Arc::new(DefaultSystemClock::new()),
+                stale,
+            )
+            .await;
+            assert!(
+                matches!(result, Err(error::SlateDBError::Fenced)),
+                "replaying epoch {stale} must be refused, got {}",
+                result.err().map(|e| e.to_string()).unwrap_or_else(|| "Ok(..)".to_owned())
+            );
+        }
+        let after = ms.read_latest_manifest().await.unwrap();
+        assert_eq!(
+            before.manifest.writer_epoch, after.manifest.writer_epoch,
+            "a refused claim writes nothing at all"
+        );
+    }
+
