+/// Total transient-attempt budget for one segment SST upload. Each attempt
+/// already carries the object-store client's own bounded retries underneath
+/// it, so the budget bounds total request pressure rather than being the
+/// only limit. Exhaustion is a typed, terminal flush failure — the flush
+/// loop must never spin invisibly on a store outage.
+pub(crate) const UPLOAD_ATTEMPT_BUDGET: u32 = 8;
+
+/// An upload error is terminal when it is anything but `Unavailable`:
+/// fenced writers, data corruption, internal invariant violations, invalid
+/// configuration/state, and closed databases fail identically on every
+/// retry, so retrying them is an unbounded loop with extra steps. Only the
+/// transient `Unavailable` class earns the bounded retry above.
+pub(crate) fn upload_error_is_terminal(error: &SlateDBError) -> bool {
+    !matches!(
+        crate::Error::from(error.clone()).kind(),
+        crate::ErrorKind::Unavailable
+    )
+}
