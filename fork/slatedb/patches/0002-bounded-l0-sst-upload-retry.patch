+    // ----------------------------------------------------------------
+    // Bounded-retry patch: the upload loop terminates on every path.
+    // ----------------------------------------------------------------
+
+    /// With the SlateDB WAL DISABLED and an object store that fails every
+    /// request, the uploader must FAIL the flush loudly within its attempt
+    /// budget — the upstream loop retried forever, pinning flush/close for
+    /// as long as the outage lasted. The 30 s ceiling only bounds the test;
+    /// the budget itself (8 attempts x 100 ms backoff) resolves in ~1 s.
+    #[cfg(feature = "wal_disable")]
+    #[tokio::test]
+    async fn upload_fails_loudly_within_the_attempt_budget_when_the_store_keeps_failing() {
+        let fp_registry = Arc::new(FailPointRegistry::new());
+        fail_parallel::cfg(
+            Arc::clone(&fp_registry),
+            "write-compacted-sst-io-error",
+            "return",
+        )
+        .unwrap();
+        let mut settings = Settings::default();
+        settings.wal_enabled = false;
+        settings.manifest_poll_interval = Duration::from_millis(100);
+        let db = setup_db_with_settings(
+            "/tmp/test_parallel_l0_flush_uploader_bounded_budget",
+            fp_registry,
+            settings,
+        )
+        .await;
+        assert!(!db.wal_enabled, "this test exercises the WAL-off posture");
+        let job = next_upload_job(&db, b"key", b"value", 1);
+
+        let test = start_test_uploader(&db);
+        test.submit(job).unwrap();
+
+        let result = timeout(Duration::from_secs(30), test.await_closed())
+            .await
+            .expect("bounded retry must terminate: the upstream loop spins here forever");
+        let error = result.expect_err("a permanently failing store must fail the flush");
+        assert!(
+            matches!(
+                error,
+                SlateDBError::L0SstUploadRetriesExhausted {
+                    attempts: super::UPLOAD_ATTEMPT_BUDGET,
+                    ..
+                }
+            ),
+            "expected the typed budget-exhaustion error after exactly the budget, got: {error:?}"
+        );
+    }
+
+    /// The shutdown escape must NOT depend on `wal_enabled`: with the WAL
+    /// disabled an external WAL owns recovery, and a close during a store
+    /// outage must still terminate. Upstream's escape was conditional on
+    /// `wal_enabled`, so this exact scenario hung.
+    #[cfg(feature = "wal_disable")]
+    #[tokio::test]
+    async fn should_stop_retrying_on_shutdown_when_wal_disabled() {
+        let fp_registry = Arc::new(FailPointRegistry::new());
+        fail_parallel::cfg(
+            Arc::clone(&fp_registry),
+            "write-compacted-sst-io-error",
+            "return",
+        )
+        .unwrap();
+        let mut settings = Settings::default();
+        settings.wal_enabled = false;
+        // long backoff: termination must come from the shutdown escape
+        // observed inside the retry loop, not from budget exhaustion
+        settings.manifest_poll_interval = Duration::from_millis(50);
+        let db = setup_db_with_settings(
+            "/tmp/test_parallel_l0_flush_uploader_shutdown_wal_disabled",
+            fp_registry,
+            settings,
+        )
+        .await;
+        assert!(!db.wal_enabled, "this test exercises the WAL-off posture");
+        let job = next_upload_job(&db, b"key", b"value", 1);
+
+        let test = start_test_uploader(&db);
+        test.submit(job).unwrap();
+
+        // Mark the database as closed (simulates Db::close()).
+        db.status_manager.write_result(Ok(()));
+
+        let result = timeout(Duration::from_secs(5), test.await_closed())
+            .await
+            .expect("the uploader must stop retrying on shutdown even with the WAL disabled");
+        assert!(result.is_err());
+    }
+
+    /// Terminal-error classification: only `Unavailable` earns the bounded
+    /// retry; fenced/data/internal/invalid/closed errors fail on first
+    /// sight because they are deterministic.
+    #[test]
+    fn only_unavailable_upload_errors_are_retryable() {
+        use super::upload_error_is_terminal;
+        // transient: an io error maps to ErrorKind::Unavailable
+        assert!(!upload_error_is_terminal(&SlateDBError::IoError(Arc::new(
+            std::io::Error::other("transient store outage")
+        ))));
+        // terminal: fenced (Closed(Fenced)), data, internal, invalid, closed
+        assert!(upload_error_is_terminal(&SlateDBError::Fenced));
+        assert!(upload_error_is_terminal(&SlateDBError::InvalidDBState));
+        assert!(upload_error_is_terminal(
+            &SlateDBError::CompactorExecutorFailed
+        ));
+        assert!(upload_error_is_terminal(&SlateDBError::InvalidCompaction));
+        assert!(upload_error_is_terminal(&SlateDBError::Closed));
+        // the budget-exhaustion error surfaces as Unavailable at the public
+        // boundary (the store WAS unavailable); it never re-enters the
+        // retry loop because it is only constructed on the way out of it
+        assert_eq!(
+            crate::Error::from(SlateDBError::L0SstUploadRetriesExhausted {
+                attempts: super::UPLOAD_ATTEMPT_BUDGET,
+                last_error: "io error".to_owned(),
+            })
+            .kind(),
+            crate::ErrorKind::Unavailable
+        );
+    }
