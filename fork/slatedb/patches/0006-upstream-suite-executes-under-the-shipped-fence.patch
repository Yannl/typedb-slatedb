+// ---------------------------------------------------------------------------
+// FORK PATCH 0006 (R6-FORK-01): the test harness plays the controller.
+//
+// Under the shipped `external_epoch_required` posture there is no internal
+// epoch allocation to fall back on, so an upstream test that opens a database
+// without an epoch is refused at the fence before its body runs. Round 5
+// left 420 such tests failing and called that a pass; it was not — those
+// bodies never exercised reads, writes, compaction, manifest handling,
+// recovery, GC, concurrency or fault behaviour under the feature that ships.
+//
+// The fix is a SINGLE test-only seam rather than 420 edits: when the crate is
+// compiled for its own tests AND the fence is on, an open that names no epoch
+// is issued one by the harness below. That is not a fallback to upstream's
+// observe-and-bind allocation — the harness is a stand-in CONTROLLER: it
+// decides the number, and the manifest still claims exactly it or refuses.
+// The seam is `cfg(test)`, so it cannot exist in the shipped library: a
+// dependent crate (TypeDB's `storage`) compiles the `None` arm as a refusal,
+// exactly as before.
+//
+// The issuer is deterministic per database: the Nth open of a given path in a
+// process claims epoch N. Explicit epochs supplied by a test are never
+// overridden — they are only OBSERVED, so a later harness-issued open of the
+// same database is still a strict successor and the two schemes compose.
+//
+// Tests that must prove the fence still fails closed opt OUT explicitly via
+// `without_controller_issued_epoch()`; see the negative suite at the bottom
+// of this file.
+// ---------------------------------------------------------------------------
+#[cfg(all(test, feature = "external_epoch_required"))]
+pub(crate) mod test_epoch_issuer {
+    use object_store::path::Path;
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+
+    fn issued() -> &'static Mutex<HashMap<String, u64>> {
+        static ISSUED: OnceLock<Mutex<HashMap<String, u64>>> = OnceLock::new();
+        ISSUED.get_or_init(|| Mutex::new(HashMap::new()))
+    }
+
+    /// Record an epoch a test chose for itself, so anything this issuer hands
+    /// out for the same database afterwards is a strict successor rather than
+    /// a replay the fence would (correctly) refuse.
+    pub(crate) fn observe(path: &Path, epoch: u64) {
+        let mut issued = issued().lock().expect("test epoch issuer poisoned");
+        let high = issued.entry(path.to_string()).or_insert(0);
+        *high = (*high).max(epoch);
+    }
+
+    /// Issue the next epoch for `path`: 1 for the first open of that database
+    /// in this process, 2 for the next, and so on.
+    pub(crate) fn issue(path: &Path) -> u64 {
+        let mut issued = issued().lock().expect("test epoch issuer poisoned");
+        let high = issued.entry(path.to_string()).or_insert(0);
+        *high += 1;
+        *high
+    }
+
+    /// The epoch this open should present: the test's own if it named one,
+    /// otherwise a freshly issued successor — unless the test explicitly
+    /// opted out to exercise the refusal.
+    pub(crate) fn resolve(path: &Path, configured: Option<u64>, opted_out: bool) -> Option<u64> {
+        match configured {
+            Some(epoch) => {
+                observe(path, epoch);
+                Some(epoch)
+            }
+            None if opted_out => None,
+            None => Some(issue(path)),
+        }
+    }
+}
